# Local development settings. bin/setup copies this file to .env, which
# Docker Compose reads automatically. These are throwaway local credentials;
# never reuse them anywhere real.
#
# The Rails app has the same values built in as development/test defaults
# (config/database.yml, config/storage.yml), so running natively against the
# Compose services needs no extra setup. If you change a value here and run
# Rails natively, export it in your shell too.

# PostgreSQL (pgvector/pgvector:pg16)
POSTGRES_USER=towertrace
POSTGRES_PASSWORD=towertrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (S3-compatible evidence store)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=towertrace
S3_SECRET_ACCESS_KEY=towertrace-dev-secret
S3_REGION=us-east-1
S3_BUCKET=towertrace-evidence
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Active Storage service name from config/storage.yml (minio or local)
ACTIVE_STORAGE_SERVICE=minio

# Rails
APP_PORT=3000
