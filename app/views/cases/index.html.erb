<% content_for :title, "Cases" %>

<header class="page-header">
  <h1>Cases</h1>
  <%= link_to "New case", new_case_path, class: "button" %>
</header>

<% if @cases.any? %>
  <table class="table" id="cases">
    <thead>
      <tr><th>Name</th><th>Description</th><th>Updated</th></tr>
    </thead>
    <tbody>
      <% @cases.each do |kase| %>
        <tr id="<%= dom_id(kase) %>">
          <td><%= link_to kase.name, kase %></td>
          <td><%= truncate(kase.description, length: 120) %></td>
          <td><%= l(kase.updated_at, format: :short) %> UTC</td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="empty">No cases yet.</p>
<% end %>
